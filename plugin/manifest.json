{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.kirkanos.fritzbox",
  "Name": "Fritz!Box Control",
  "Version": "0.0.0.0",
  "Author": "Andreas Hacker",
  "Description": "Guest WLAN and internet status of a Fritz!Box on the Stream Deck: switch the guest network, show its Wi-Fi QR code and see your connection. Unofficial plugin, not affiliated with AVM.",
  "URL": "https://github.com/kirkanos/Streamdeck-Fritzbox",
  "Icon": "images/icon",
  "Category": "Fritz!Box Control",
  "CategoryIcon": "images/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.kirkanos.fritzbox.guest-wlan",
      "Name": "Guest WLAN",
      "Icon": "images/actions/guest-wlan",
      "Tooltip": "Guest WLAN on/off with SSID and connected guests; press to toggle, hold to show the Wi-Fi QR code",
      "PropertyInspectorPath": "ui/guest-wlan.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "images/key",
          "TitleAlignment": "top",
          "FontSize": 10
        }
      ]
    },
    {
      "UUID": "com.kirkanos.fritzbox.online",
      "Name": "Online",
      "Icon": "images/actions/online",
      "Tooltip": "Internet connection: status, external IP, current down/up rate and uptime; press to open the Fritz!Box",
      "PropertyInspectorPath": "ui/online.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "images/key",
          "TitleAlignment": "top",
          "FontSize": 10
        }
      ]
    },
    {
      "UUID": "com.kirkanos.fritzbox.guest-dial",
      "Name": "Guest WLAN Dial",
      "Icon": "images/actions/dial",
      "Tooltip": "Shows the guest Wi-Fi QR code on the touch strip while the guest WLAN is on; push to toggle",
      "PropertyInspectorPath": "ui/guest-dial.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/dial.json",
        "Icon": "images/actions/dial",
        "TriggerDescription": {
          "Push": "Guest WLAN on / off",
          "Touch": "Guest WLAN on / off"
        }
      },
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "images/key"
        }
      ]
    }
  ]
}
